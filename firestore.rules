rules_version = '2';
// ZAN keeps each notebook as its own document under the signed-in person's uid:
//   users/{uid}/books/p        personal notebook
//   users/{uid}/books/w        work notebook (synced only when turned on for work)
//   users/{uid}/books/profile  settings and cert packs
// Nobody can read or write anyone else's documents. AI usage counters (zanUsage) are written by the server only.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/books/{book} {
      function mine() {
        return request.auth != null && request.auth.uid == uid;
      }
      function known() {
        return book in ['p', 'w', 'profile'];
      }
      function valid() {
        let d = request.resource.data;
        return d.keys().hasOnly(['data', 'updatedAt', 'v'])
          && d.data is string && d.data.size() < 900000
          && d.updatedAt is int && d.v == 1;
      }
      allow read, delete: if mine() && known();
      allow create, update: if mine() && known() && valid();
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
